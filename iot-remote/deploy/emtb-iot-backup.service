[Unit]
Description=EMTB IoT encrypted SQLite recovery backup
After=emtb-iot-remote.service

[Service]
Type=oneshot
WorkingDirectory=%h/services/emtb-iot-remote
UMask=0077
ExecStart=/usr/bin/python3.12 -m iot_remote backup --db %h/services/emtb-iot-remote/var/iot.sqlite3 --recipient-cert %h/.config/emtb-iot/backup-recipient.pem --output-dir %h/services/emtb-iot-remote/recovery
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/services/emtb-iot-remote/recovery %h/services/emtb-iot-remote/var

[Install]
WantedBy=default.target
