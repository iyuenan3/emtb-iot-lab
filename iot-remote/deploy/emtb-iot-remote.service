[Unit]
Description=单车 IoT 远程调试服务
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/services/emtb-iot-remote
EnvironmentFile=%h/services/emtb-iot-remote/.env
ExecStart=/usr/bin/python3 -m iot_remote serve --db %h/services/emtb-iot-remote/var/iot.sqlite3 --target-imei ${TARGET_IMEI} --vehicle-name ${VEHICLE_NAME} --tcp-host ${TCP_HOST} --tcp-port ${TCP_PORT} --http-host ${HTTP_HOST} --http-port ${HTTP_PORT} --location-min-satellites ${LOCATION_MIN_SATELLITES} --location-max-hdop ${LOCATION_MAX_HDOP} --location-max-speed-mps ${LOCATION_MAX_SPEED_MPS} --offline-movement-threshold-m ${OFFLINE_MOVEMENT_THRESHOLD_M} --offline-sample-max-separation-m ${OFFLINE_SAMPLE_MAX_SEPARATION_M}
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/services/emtb-iot-remote/var
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
